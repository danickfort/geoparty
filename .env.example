# Required — the admin panel is disabled without it
ADMIN_PASSWORD=change-me

# Optional
PORT=3000
# Public URL encoded in the QR code. If unset, it is derived from the
# request headers of the game screen (set it when behind a reverse proxy
# that does not forward x-forwarded-proto/host).
#PUBLIC_URL=https://geoparty.example.com

# Slack results posting (optional). Both must be set to enable posting; the
# admin's "Post to Slack" button and results preview work regardless. The bot
# token needs the chat:write scope.
#SLACK_BOT_TOKEN=xoxb-your-bot-token
#SLACK_CHANNEL=#geoparty
