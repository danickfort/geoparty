# Required — the admin panel is disabled without it
ADMIN_PASSWORD=change-me

# Optional
PORT=3000
# Public URL encoded in the QR code. If unset, it is derived from the
# request headers of the game screen (set it when behind a reverse proxy
# that does not forward x-forwarded-proto/host).
#PUBLIC_URL=https://geoparty.example.com

# Slack results posting (optional). A Slack Workflow Builder webhook URL — the
# workflow's trigger must declare a `text` variable, and its "Send a message"
# step posts that variable. The admin's "Post to Slack" button and results
# preview work regardless of whether this is set.
#SLACK_WEBHOOK_URL=https://hooks.slack.com/triggers/T00000000/000000000000/xxxxxxxxxxxxxxxx
