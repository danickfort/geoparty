# Copy to .env and keep it OFF git (the .env file is gitignored).
#
# GitHub Personal Access Token used by the runner to register itself.
# - Classic token: needs the `repo` scope.
# - Fine-grained token: scope it to the krabilousse/geoparty repo with
#   "Administration: Read and write" (needed to manage self-hosted runners).
RUNNER_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
