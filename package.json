{
  "name": "geoparty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build && tsc -p tsconfig.server.json",
    "start": "node server/dist/server/index.js",
    "tunnel": "node scripts/tunnel.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "canvas-confetti": "^1.9.3",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.11.1",
    "multer": "^2.0.1",
    "pinia": "^3.0.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.1",
    "@types/leaflet": "^1.9.17",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
