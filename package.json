{
  "name": "geoparty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build && tsc -p tsconfig.server.json",
    "start": "node server/dist/server/index.js",
    "tunnel": "node scripts/tunnel.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "canvas-confetti": "^1.9.4",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.15.0",
    "multer": "^2.5.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
