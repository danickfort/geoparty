{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "server/dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["server/**/*", "shared/**/*"],
  "exclude": ["server/dist"]
}
